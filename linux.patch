+#define TSRST_ENCSRST BIT(1)
+#define TSRST_FIFOSRST BIT(2)
+#define TSRST_CCSRST BIT(3)
+#define TSRST_HDCPSRST BIT(4)
+#define TSRST_AUDSRST BIT(6)
